# Copy to .env and fill in local values. Never commit .env.

# Required for Cursor SDK agent calls. Unused by the stub CLI.
CURSOR_API_KEY=

# Optional model id for agent calls.
CURSOR_MODEL=

# Optional path overrides. Defaults are this repository's dataset/,
# output.csv, and .sandbox/.
# DATASET_DIR=
# OUTPUT_PATH=
# SANDBOX_ROOT=
